    {
      "name": "dailyflow.capabilities",
      "description": "List the current in-process DailyFlow module capabilities and visible shared subjects.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": true,
      "private_data": true,
      "implemented_by": "app"
    },
    {
      "name": "dailyflow.module_query",
      "description": "Read full source totals or upcoming plans through selected in-process modules; returns bounded source references.",
      "input_schema": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "flow_id": {
            "type": "string"
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capability"
              ],
              "properties": {
                "capability": {
                  "type": "string",
                  "enum": [
                    "expense.summary",
                    "calendar.next",
                    "period.history"
                  ]
                },
                "period": {
                  "type": "string",
                  "enum": [
                    "all",
                    "today",
                    "this_month",
                    "last_month"
                  ]
                },
                "date_from": {
                  "type": "string"
                },
                "date_to": {
                  "type": "string"
                },
                "tag": {
                  "type": "string",
                  "maxLength": 40
                },
                "keyword": {
                  "type": "string",
                  "maxLength": 180
                }
              }
            }
          }
        },
        "required": [
          "queries"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": true,
      "private_data": true,
      "implemented_by": "app"
    },
    {
      "name": "dailyflow.timeline_query",
      "description": "Read registered dated sources across modules; inclusive civil-date overlap, snapshot-checked pagination. Includes period records when selected or querying all sources.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date_from": {
            "type": "string"
          },
          "date_to": {
            "type": "string"
          },
          "source_module": {
            "type": "string"
          },
          "flow_id": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "snapshot_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": false,
      "private_data": true,
      "implemented_by": "app"
    },
    {
      "name": "dailyflow.recall",
      "description": "Read-only on-demand timeline by literal record title or an existing subject name. Expand only confirmed typed relations. Does not create a Flow or infer causality.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 80
          },
          "flow_id": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "snapshot_revision": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": false,
      "private_data": true,
      "implemented_by": "app"
    },
    {
      "name": "dailyflow.experience_context",
      "description": "Read only the active DailyFlow experience task context by the exact request_id supplied by the UI. Returns current allowed catalog or bounded source records. Never writes source records. Old or cancelled task IDs fail closed.",
      "input_schema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": false,
      "private_data": true,
      "implemented_by": "app"
    },
    {
      "name": "dailyflow.experience_result",
      "description": "Submit structured suggestions for the currently active read-only experience task. First read experience_context using the same request_id; submit plan for selection phase or organization for organize phase. No source write and no user confirmation. Expired or invalid references are rejected.",
      "input_schema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "plan": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "query",
                  "clarify"
                ]
              },
              "topic": {
                "type": "string"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "question": {
                "type": "string"
              }
            },
            "required": [
              "intent",
              "topic",
              "start",
              "end",
              "sources",
              "question"
            ],
            "additionalProperties": false
          },
          "organization": {
            "type": "object",
            "properties": {
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "source_app": {
                            "type": "string"
                          },
                          "source_module": {
                            "type": "string"
                          },
                          "record_id": {
                            "type": "string"
                          },
                          "revision": {
                            "type": "integer"
                          },
                          "quote": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source_app",
                          "source_module",
                          "record_id",
                          "revision",
                          "quote"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "text",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 6
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "same_experience",
                        "sequence",
                        "supports"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "from": {
                      "type": "object",
                      "properties": {
                        "source_app": {
                          "type": "string"
                        },
                        "source_module": {
                          "type": "string"
                        },
                        "record_id": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer"
                        },
                        "quote": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "source_app",
                        "source_module",
                        "record_id",
                        "revision",
                        "quote"
                      ],
                      "additionalProperties": false
                    },
                    "to": {
                      "type": "object",
                      "properties": {
                        "source_app": {
                          "type": "string"
                        },
                        "source_module": {
                          "type": "string"
                        },
                        "record_id": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer"
                        },
                        "quote": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "source_app",
                        "source_module",
                        "record_id",
                        "revision",
                        "quote"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "reason",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 12
              }
            },
            "required": [
              "claims",
              "edges"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": false,
      "private_data": true,
      "implemented_by": "app"
    }
  ]
}
