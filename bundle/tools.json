{
  "schema": 1,
  "tools": [
    {
      "name": "dailyflow.query",
      "description": "Query supported expense/event sources only; excludes archived history and receipts.",
      "input_schema": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "flow_id": {
            "type": "string"
          },
          "flow_name": {
            "type": "string"
          },
          "source_module": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": true,
      "private_data": true,
      "implemented_by": "app"
    },
    {
      "name": "dailyflow.flow_query",
      "description": "Query typed event graph and deterministic actual expense total.",
      "input_schema": {
        "type": "object",
        "properties": {
          "flow_id": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "shareable": true,
      "private_data": true,
      "implemented_by": "app"
    },
    {
      "name": "dailyflow.save_record",
      "description": "Save/correct/delete supported source records. period_entry uses date/end_date; no predictions. Preserve request_id and revision.",
      "input_schema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "flow_id": {
            "type": "string"
          },
          "event_title": {
            "type": "string"
          },
          "plan_title": {
            "type": "string"
          },
          "plan_date": {
            "type": "string"
          },
          "plan_time": {
            "type": "string"
          },
          "related_event_id": {
            "type": "string"
          },
          "fulfills_id": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "expense",
              "event",
              "period_entry"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "save",
              "delete",
              "link",
              "unlink",
              "delete_flow"
            ]
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "flow_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "user_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "end_date": {
            "type": "string",
            "description": "Recorded inclusive end date for period_entry, empty when not recorded."
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "destructive",
      "shareable": true,
      "private_data": true,
      "implemented_by": "app",
      "confirm": "host"
    },
