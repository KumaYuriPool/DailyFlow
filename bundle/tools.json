    {
      "name": "dailyflow.capabilities",
      "description": "List the current in-process DailyFlow module capabilities and visible shared subjects.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
