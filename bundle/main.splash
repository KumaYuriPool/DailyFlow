// DailyFlow v0.4 baseline — minimal calendar, no on_render trick
// Each cell is a separate GestureView with hard-coded text. selected_day tracked.
// NO parse_int, NO triple-conditional expressions — keep syntax simple.

let ink = #x1c1c1e
let sub = #x8e8e93
let blue = #x007aff
let blue_light = #xe5f1ff
let red = #xff3b30
let bg = #xf5f5f7
let card = #xffffff

let current_year = 2026
let current_month = 10
let selected_day = 15

fn days_in_month(y, m){
    if m == 2 {
        let leap = (y % 4 == 0) && ((y % 100 != 0) || (y % 400 == 0))
        if leap { return 29 }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 { return 30 }
    return 31
}

fn first_weekday(y, m){
    let y0 = 1970
    let m0 = 1
    let total = 0
    if y > y0 || (y == y0 && m > m0) {
        let yy = y0
        while yy < y {
            total = total + days_in_month(yy, m)
            yy = yy + 1
        }
        let mm = m0
        while mm < m {
            total = total + days_in_month(y, mm)
            mm = mm + 1
        }
    } else {
        let yy = y
        while yy < y0 {
            total = total - days_in_month(yy, m)
            yy = yy + 1
        }
        let mm = m
        while mm > m0 {
            total = total - days_in_month(y, mm - 1)
            mm = mm - 1
        }
    }
    let wd = ((total % 7) + 4 + 7) % 7
    return (wd + 6) % 7
}

fn is_in_month(d){
    let first = first_weekday(current_year, current_month)
    let total = days_in_month(current_year, current_month)
    let day_idx = d - first
    if day_idx < 0 { return 0 }
    if day_idx >= total { return 0 }
    return 1
}

fn prev_month(){
    if current_month == 1 { current_month = 12 current_year = current_year - 1 }
    else { current_month = current_month - 1 }
    selected_day = 1
}

fn next_month(){
    if current_month == 12 { current_month = 1 current_year = current_year + 1 }
    else { current_month = current_month + 1 }
    selected_day = 1
}

fn select_day(d){
    selected_day = d
}

fn boot(){}

SolidView{width: Fill height: Fill flow: Down draw_bg.color: bg

    View{width: Fill height: 60 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 16}
        ButtonFlat{text: "<" height: 32 width: 32 on_click: || prev_month()
            draw_bg +: {border_radius: 16.0 color: card color_hover: #xe5e5ea color_down: #xd1d1d6 border_size: 0.0}
            draw_text +: {color: ink color_hover: ink color_down: ink}}
        Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_bold{font_size: 22}
            align: Align{x: 0.5, y: 0.5}
            on_render: || set_text("" + current_year + " 年 " + current_month + " 月")}
        ButtonFlat{text: ">" height: 32 width: 32 on_click: || next_month()
            draw_bg +: {border_radius: 16.0 color: card color_hover: #xe5e5ea color_down: #xd1d1d6 border_size: 0.0}
            draw_text +: {color: ink color_hover: ink color_down: ink}}
    }

    View{width: Fill height: Fit flow: Right padding: Inset{left: 16 right: 16 top: 8 bottom: 8} spacing: 4
        Label{width: Fill text: "一" draw_text.color: sub draw_text.text_style.font_size: 12}
        Label{width: Fill text: "二" draw_text.color: sub draw_text.text_style.font_size: 12}
        Label{width: Fill text: "三" draw_text.color: sub draw_text.text_style.font_size: 12}
        Label{width: Fill text: "四" draw_text.color: sub draw_text.text_style.font_size: 12}
        Label{width: Fill text: "五" draw_text.color: sub draw_text.text_style.font_size: 12}
        Label{width: Fill text: "六" draw_text.color: sub draw_text.text_style.font_size: 12}
        Label{width: Fill text: "日" draw_text.color: red draw_text.text_style.font_size: 12}
    }

    View{width: Fill height: Fill flow: Down padding: Inset{left: 8 right: 8 top: 4 bottom: 8} spacing: 4
