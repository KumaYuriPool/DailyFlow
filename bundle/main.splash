            }
            View{width: Fill height: 34 flow: Right spacing: 4
                date_jump := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 34 text: jump_date on_change: |v| { jump_date = v } on_return: |v| jump()}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 70 text: "定位" on_click: || jump()}
            }
            View{width: Fill height: 20 flow: Right for day in ["一" "二" "三" "四" "五" "六" "日"] { Label{width: Fill align: Align{x: 0.5 y: 0.5} text: day draw_text.color: muted} }}
            let offset = (epoch_day(date_text(yy,mm,1)) + 3) % 7
            let rows = floor((offset+month_days(yy,mm)+6)/7)
            for row in rows { View{width: Fill height: 56 flow: Right spacing: 3
                for col in 7 { let n = row*7+col-offset+1
                    let valid = n > 0 && n <= month_days(yy,mm)
                    let bg = #xffffff let fg = ink let border = #xffffff
                    if !valid { fg = #xbfc5bf }
                    if valid && today() == date_text(yy,mm,n) { border = accent }
                    if valid && selected == date_text(yy,mm,n) { bg = accent fg = #xffffff border = accent }
                    View{width: Fill height: 56 flow: Down spacing: 0 padding: 0 align: Align{x: 0.5 y: 0.0}
                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 34 height: 34 margin: 0 label_walk: Walk{width: Fit height: Fit} draw_bg +: {color: bg color_hover: #xdce7dc color_down: accent border_color: border border_size: 1.0 border_radius: 17.0} draw_text +: {color: fg color_hover: ink color_down: #xffffff} text: calendar_cell_label(n) on_click: || pick_day(n)}
                        if calendar_mode == "ledger" { Label{width: Fill height: 20 margin: 0 padding: 0 align: Align{x: 0.5 y: 0.5} text: day_content(n) draw_text.color: accent draw_text.text_style.font_size: 9 draw_text.text_overflow: Ellipsis draw_text.max_lines: 1} }
                    }

                }
            } }
            }
            View{width: Fill height: Fit flow: Down spacing: 7
            Label{width: Fill text: "本月" + scope_label() + "支出 ¥" + money(calendar_sum("",month_of(selected),scope_id())) draw_text.color: accent}
            Label{width: Fill text: "浏览 " + selected + " · " + scope_label() draw_text.color: ink}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "以这一天补记" on_click: || backfill_here()}
            let items = calendar_query(selected,"",scope_id(),calendar_mode)
            if items.len() == 0 { Label{text: "这一天还没有记录" draw_text.color: muted} }
            for e in items { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: calendar_item_label(e) on_click: || view_open(e.source_record_id)} }
            }
            }
        }}
        period_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 visible: true on_render: || {
            Label{width: Fill text: "经期记录" draw_text.color: ink draw_text.text_style.font_size: 22}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: "+ 记一次经期" on_click: || view_new("period_entry")}
            let rows = period_snapshot(db)
            if rows.len() == 0 { Label{width: Fill text: "记下开始和结束的日期，方便以后回看。" draw_text.color: muted} }
            for r in rows { let end = r.end_date if end == "" { end = "还未记结束日期" } ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 44 text: r.date + " 至 " + end on_click: || view_open(r.id)} }
        }}
        ledger_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            Label{text: "支出账本" draw_text.color: ink draw_text.text_style.font_size: 22}
            View{width: Fill height: 36 flow: Right spacing: 4
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "+ 记一笔" on_click: || view_new("expense")}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "全部 / 选中日" on_click: || { ledger_day_only = !ledger_day_only redraw() }}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: scope_label() on_click: || { if active_flow != "" { scope_current = !scope_current redraw() } }}
            }
            let day = "" if ledger_day_only { day = selected }
            Label{width: Fill text: scope_label() + "支出 ¥" + money(calendar_sum(day,"",scope_id())) draw_text.color: accent}
            for e in calendar_query(day,"",scope_id(),"ledger") {
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 46 text: e.date + "  " + projection_label(e) on_click: || view_open(e.source_record_id)}
            }
        }}
        graph_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            let graph = flow_query(active_flow)
            Label{width: Fill text: graph.name draw_text.color: ink draw_text.text_style.font_size: 22}
            Label{width: Fill text: "已发生 ¥" + money(graph.amount_minor) + " · " + graph.plans + " 项计划" draw_text.color: accent}
            if graph.nodes.len() > 0 { Label{width: Fill text: graph.nodes[0].date + " — " + graph.nodes[graph.nodes.len()-1].date draw_text.color: muted draw_text.text_style.font_size: 10} }
            for e in graph.nodes { if e.source_module == "calendar" {
                for edge in graph.relations { if edge.type == "follow_up" && edge.to_node == e.source_record_id {
                    let parent = source_get(edge.from_node)
                    if parent != nil { Label{width: Fill text: "┊ " + graph_node_label(graph,parent.id) + " → 明确后续安排 ↓" draw_text.color: muted draw_text.text_style.font_size: 11} }
                } if edge.type == "fulfills" && edge.from_node == e.source_record_id { Label{width: Fill text: "━━ 完成计划 → " + source_get(edge.to_node).title draw_text.color: accent} } }
                let border = "━━ 已发生" if e.status == "planned" { border = "┄ ┄ 计划 ┄ ┄" } if e.status == "cancelled" { border = "已撤回" } if flow_plan_fulfilled(e.source_record_id) { border = "━━ 计划已实现" }
                SolidView{width: Fill height: Fit flow: Down padding: 10 spacing: 5 draw_bg.color: #xffffff
                    Label{width: Fill text: border + " · " + e.date + " " + e.time draw_text.color: accent draw_text.text_style.font_size: 11}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: graph_node_label(graph,e.source_record_id) on_click: || view_open(e.source_record_id)}
                    for edge in graph.relations { if edge.type == "expense_for" && edge.from_node == e.source_record_id {
                        let expense = expense_get(edge.to_node)
                        if expense != nil { View{width: Fill height: 44 flow: Right spacing: 4
                            Label{width: 96 text: "费用归属 →" draw_text.color: muted draw_text.text_style.font_size: 11 draw_text.max_lines: 1}
                            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: "记账 · " + expense.title + " ¥" + money(expense.cents) on_click: || view_open(expense.id)}
                        } }
                    } }
                }
            } }
            for e in graph.nodes { if e.source_module == "expense" && !flow_expense_attached(e.source_record_id,active_flow) { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: "独立费用 · " + projection_label(e) on_click: || view_open(e.source_record_id)} } }
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "删除事件关系（保留源记录）" on_click: || delete_flow()}
        }}
        detail_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            let r = source_get(detail_id)
            if r != nil {
                Label{width: Fill text: r.title draw_text.color: ink draw_text.text_style.font_size: 23}
                Label{width: Fill text: r.date draw_text.color: muted}
                if r.kind == "expense" { Label{text: "¥" + money(r.cents) draw_text.color: accent draw_text.text_style.font_size: 26}
                    Label{width: Fill text: business_optional(r,"category","") draw_text.color: muted}
                    Label{width: Fill text: record_tags_text(r) draw_text.color: accent}
                }
                else { if r.kind == "period_entry" { let end = r.end_date if end == "" { end = "还未记结束日期" } Label{width: Fill text: "结束：" + end draw_text.color: muted} } else { Label{text: state_label(r.status) + " · " + r.time draw_text.color: accent} } }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: "修改" on_click: || view_edit()}
                if r.kind == "event" { for cost in event_expenses(r.id,"","") { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: "费用 · " + cost.summary + " ¥" + money(cost.amount_minor) on_click: || view_open(cost.source_record_id)} } }
                if r.kind == "expense" { for rel in flow_relations(db) { if rel.type == "expense_for" && rel.to_node == r.id { let fact = source_get(rel.from_node) if fact != nil { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: "相关事项 · " + fact.title on_click: || view_open(fact.id)} } } } }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "定位到日历" on_click: || { jump_date = r.date jump() go("calendar") }}
                for f in flow_catalog(db) { if member(r,f.id) { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "回看「" + f.name + "」" on_click: || recall_open_flow(f.id)} } }
                if r.kind != "period_entry" {
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "调整关联 ▾" on_click: || { membership_open = !membership_open ui.detail_page.render() }}
                    if membership_open {
                    for f in flow_catalog(db) { let action = "加入 " if member(r,f.id) { action = "移出 " } ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: action + f.name on_click: || toggle_member(f.id)} }
                    for f in flow_catalog(db) { if member(r,f.id) { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "管理关联 · " + f.name on_click: || graph_open(f.id)} } }
                    }
                }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "删除源记录" on_click: || delete_record()}
            } else { Label{text: "记录已删除" draw_text.color: muted} }
        }}
        edit_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            Label{text: "修改 / 记录" draw_text.color: ink draw_text.text_style.font_size: 20}
            if draft_kind == "period_entry" { Label{width: Fill text: "开始日期" draw_text.color: ink} }
            else { record_title := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_title empty_text: "事项" on_change: |v| { draft_title = v }} }
            record_date := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_date empty_text: "YYYY-MM-DD" on_change: |v| { draft_date = v }}
            if draft_kind == "expense" { record_amount := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_value empty_text: "金额（元）" on_change: |v| { draft_value = v }}
                record_category := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_category empty_text: "分类（可选）" on_change: |v| { draft_category = v }}
            }
            if draft_kind == "period_entry" {
                Label{width: Fill text: "上方为开始日期；尚未结束可留空下方。" draw_text.color: muted}
                record_end := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_end empty_text: "结束日期 YYYY-MM-DD，可空" on_change: |v| { draft_end = v }}
            }
            if draft_kind == "event" {
                record_time := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_time empty_text: "时间 HH:MM，可空" on_change: |v| { draft_time = v }}
                Label{text: state_label(draft_status) draw_text.color: accent}
                View{width: Fill height: 40 flow: Right
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "计划" on_click: || { draft_status = "planned" redraw() }}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "确认已发生" on_click: || { draft_status = "occurred" redraw() }}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "撤回" on_click: || { draft_status = "cancelled" redraw() }}
                }
            }
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 44 text: "保存记录" on_click: || save_record()}
        }}
        settings_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            Label{text: "本地数据" draw_text.color: ink draw_text.text_style.font_size: 22}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "导出备份" on_click: || export_backup()}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "恢复 backup.json" on_click: || restore_backup()}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "导入旧账本" on_click: || expense_import()}
            Label{width: Fill text: "备份保留全部历史个人数据。恢复前会另存副本。" draw_text.color: muted}
        }}
        }
        help_page := View{width: Fill height: Fill flow: Down spacing: 10 visible: false
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 34 text: "‹ 返回刚才的页面" on_click: || help_back()}
            help_content := ScrollYView{width: Fill height: Fill flow: Down spacing: 18 on_render: || {
                if help_topic < 0 {
                    Label{width: Fill text: "慢慢来，先记一件事。" draw_text.color: ink draw_text.text_style.font_size: 20}
                    Label{width: Fill text: "用到哪里，就看哪一节。说明离线可读，例句不会自动保存。" draw_text.color: muted draw_text.text_style.font_size: 12}
                    for index in help_sections.len() { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: help_sections[index].title on_click: || help_select(index)} }
                } else {
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 34 text: "‹ 说明目录" on_click: || help_select(-1)}
                    let section = help_sections[help_topic]
                    Label{width: Fill text: section.title draw_text.color: ink draw_text.text_style.font_size: 20}
                    for paragraph in section.paragraphs { Label{width: Fill text: paragraph draw_text.color: ink draw_text.text_style.font_size: 12} }
                }
            }}
        }
        }
    }
    }
}
