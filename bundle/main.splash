                                if recall_result.has_more { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "下一页" on_click: || { recall_offset = recall_result.next_offset recall_refresh() }} }
