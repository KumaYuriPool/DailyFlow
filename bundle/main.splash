            View{width: Fill height: 40 flow: Right spacing: 6
                recall_input := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 40 text: recall_text empty_text: "名字或记录名称…" on_change: |v| { recall_text = v } on_return: |v| recall_search()}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 58 height: 40 text: "搜索" on_click: || recall_search()}
            }
            recall_results := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
                if recall_result != nil {
                    if !recall_result["ok"] { Label{width: Fill text: recall_result.message draw_text.color: muted} }
                    else {
                        if recall_result.text == "" && recall_flow == "" { Label{width: Fill text: "输入名字或关键词，回看相关记录。" draw_text.color: muted} }
                        else {
                            if recall_result.flow_id == "" {
                                for candidate in recall_result.candidates { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "回看 " + candidate.label on_click: || { recall_flow = candidate.id recall_offset = 0 recall_refresh() }} }
                                if recall_result.candidate_total > 10 { Label{width: Fill text: "匹配的名字较多，请再写具体一些。" draw_text.color: muted} }
                            }
                            Label{width: Fill text: "找到 " + recall_result.total + " 条 · 按时间排列" draw_text.color: ink}
                            if recall_result.total == 0 { Label{width: Fill text: "没有找到，试试记录里的名字或关键词。" draw_text.color: muted} }
                            if recall_result.total > 0 { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 140 height: 28 text: "为什么找到这些 ▾" on_click: || { recall_explain = !recall_explain ui.recall_results.render() }} }
                            for e in recall_result.events {
                                Label{width: Fill text: "│  " + recall_date(e) draw_text.color: muted draw_text.text_style.font_size: 11}
                                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: projection_label(e) on_click: || view_open(e.source_record_id)}
                                let hint = recall_source(e) if recall_explain { hint += " · " + e.match_reason }
                                Label{width: Fill text: hint draw_text.color: muted draw_text.text_style.font_size: 10}
