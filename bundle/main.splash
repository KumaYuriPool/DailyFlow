                    // R3: read-only imported detail, kept inside this view.
                    if timeline_has_detail() {
                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 110 height: 30 text: "‹ 返回列表" on_click: || timeline_close_detail()}
                        let d = timeline_detail_record()
                        if d == nil {
                            // B3: source deleted/re-imported away — the detail
                            // lapses explicitly, old content is never shown.
                            Label{width: Fill text: "导入记录详情（已失效）" draw_text.color: accent draw_text.text_style.font_size: 14}
                            Label{width: Fill text: "该记录已不在当前导入文件中（源删除或尚未重新同步）。" draw_text.color: muted}
                        }
                        if d != nil {
                            Label{width: Fill text: "导入记录详情（只读）" draw_text.color: accent draw_text.text_style.font_size: 14}
                            Label{width: Fill text: "" + d.title draw_text.color: ink draw_text.text_style.font_size: 15}
                            Label{width: Fill text: "" + timeline_source_line(d) draw_text.color: muted draw_text.text_style.font_size: 11}
                            Label{width: Fill text: "来源身份：" + d.source_app + " / " + d.record_id + " · rev " + d.revision draw_text.color: muted draw_text.text_style.font_size: 11}
                            if d.date != "" { Label{width: Fill text: "时间：" + d.date draw_text.color: ink draw_text.text_style.font_size: 12} }
                            if d.body != "" { Label{width: Fill text: "配文：" + d.body draw_text.color: ink draw_text.text_style.font_size: 12} }
                            if d.citation != "" { Label{width: Fill text: "引用来源查询：" + d.citation draw_text.color: muted draw_text.text_style.font_size: 11} }
                            if d.suspicious || d.future { Label{width: Fill text: timeline_flags(d) draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                        }
                    }
                    else {
                        for r in timeline_records_visible() {
                            View{width: Fill height: Fit flow: Down spacing: 1
                                Label{width: Fill text: "│  " + r.date draw_text.color: muted draw_text.text_style.font_size: 11}
                                Label{width: Fill height: 40 text: timeline_record_line(r) draw_text.color: ink draw_text.text_style.font_size: 13 draw_text.text_overflow: Ellipsis draw_text.max_lines: 1}
                                Label{width: Fill text: timeline_source_line(r) draw_text.color: muted draw_text.text_style.font_size: 10}
                                if r.suspicious || r.future { Label{width: Fill text: timeline_flags(r) draw_text.color: #x8a6d00 draw_text.text_style.font_size: 10} }
                                View{width: Fill height: 30 flow: Right spacing: 5
                                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 70 height: 28 text: "详情" on_click: || timeline_open_detail(r.source_app, r.record_id)}
                                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 84 height: 28 text: "排除" on_click: || timeline_exclude(r.source_app, r.record_id)}
                                }
                            }
                        }
                        if timeline_gaps_scoped().len() > 0 {
                            Label{width: Fill text: "尚未覆盖" draw_text.color: #x8a6d00 draw_text.text_style.font_size: 12}
                            for g in timeline_gaps_scoped() { Label{width: Fill text: "· " + timeline_gap_line(g) draw_text.color: #x8a6d00 draw_text.text_style.font_size: 10} }
                        }
                    }
                }
            }}
        }
        calendar_page := ScrollYView{width: Fill height: Fill flow: Down padding: Inset{right: 12} spacing: 7 visible: true on_render: || {
            View{width: Fill height: Fit flow: Down spacing: 12
            View{width: Fill height: Fit flow: Down spacing: 7
            View{width: Fill height: 36 flow: Right spacing: 4
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 36 text: "‹" on_click: || shift_month(-1)}
                Label{width: Fill text: "" + yy + "年 " + mm + "月" draw_text.color: ink draw_text.text_style.font_size: 20}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 58 text: "今天" on_click: || { jump_date = today() jump() }}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 36 text: "›" on_click: || shift_month(1)}
            }
            View{width: Fill height: 36 flow: Right spacing: 5
                let view_label = "普通日历" if calendar_mode == "ledger" { view_label = "账本日历" }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: view_label + " ▾" on_click: || picker("views")}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: scope_label() on_click: || { if active_flow != "" { scope_current = !scope_current redraw() } else { message = "先从当天事项打开一个事件。" redraw() } }}
            }
            View{width: Fill height: 34 flow: Right spacing: 4
                date_jump := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 34 text: jump_date on_change: |v| { jump_date = v } on_return: |v| jump()}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 70 text: "定位" on_click: || jump()}
            }
            View{width: Fill height: 20 flow: Right for day in ["一" "二" "三" "四" "五" "六" "日"] { Label{width: Fill align: Align{x: 0.5 y: 0.5} text: day draw_text.color: muted} }}
            let offset = (epoch_day(date_text(yy,mm,1)) + 3) % 7
            let rows = floor((offset+month_days(yy,mm)+6)/7)
            for row in rows { View{width: Fill height: 56 flow: Right spacing: 3
                for col in 7 { let n = row*7+col-offset+1
                    let valid = n > 0 && n <= month_days(yy,mm)
                    let bg = #xffffff let fg = ink let border = #xffffff
                    if !valid { fg = #xbfc5bf }
                    if valid && today() == date_text(yy,mm,n) { border = accent }
                    if valid && selected == date_text(yy,mm,n) { bg = accent fg = #xffffff border = accent }
                    View{width: Fill height: 56 flow: Down spacing: 0 padding: 0 align: Align{x: 0.5 y: 0.0}
                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 34 height: 34 margin: 0 label_walk: Walk{width: Fit height: Fit} draw_bg +: {color: bg color_hover: #xdce7dc color_down: accent border_color: border border_size: 1.0 border_radius: 17.0} draw_text +: {color: fg color_hover: ink color_down: #xffffff} text: calendar_cell_label(n) on_click: || pick_day(n)}
                        if calendar_mode == "ledger" { Label{width: Fill height: 20 margin: 0 padding: 0 align: Align{x: 0.5 y: 0.5} text: day_content(n) draw_text.color: accent draw_text.text_style.font_size: 9 draw_text.text_overflow: Ellipsis draw_text.max_lines: 1} }
                    }

                }
            } }
            }
            View{width: Fill height: Fit flow: Down spacing: 7
            Label{width: Fill text: "本月" + scope_label() + "支出 ¥" + money(calendar_sum("",month_of(selected),scope_id())) draw_text.color: accent}
            Label{width: Fill text: "浏览 " + selected + " · " + scope_label() draw_text.color: ink}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "以这一天补记" on_click: || backfill_here()}
            let items = calendar_query(selected,"",scope_id(),calendar_mode)
            if items.len() == 0 { Label{text: "这一天还没有记录" draw_text.color: muted} }
            for e in items { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: calendar_item_label(e) on_click: || view_open(e.source_record_id)} }
            }
            }
        }}
        period_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 visible: true on_render: || {
            Label{width: Fill text: "经期记录" draw_text.color: ink draw_text.text_style.font_size: 22}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: "+ 记一次经期" on_click: || view_new("period_entry")}
            let rows = period_snapshot(db)
            if rows.len() == 0 { Label{width: Fill text: "记下开始和结束的日期，方便以后回看。" draw_text.color: muted} }
            for r in rows { let end = r.end_date if end == "" { end = "还未记结束日期" } ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 44 text: r.date + " 至 " + end on_click: || view_open(r.id)} }
        }}
        ledger_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            Label{text: "支出账本" draw_text.color: ink draw_text.text_style.font_size: 22}
            View{width: Fill height: 36 flow: Right spacing: 4
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "+ 记一笔" on_click: || view_new("expense")}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "全部 / 选中日" on_click: || { ledger_day_only = !ledger_day_only redraw() }}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: scope_label() on_click: || { if active_flow != "" { scope_current = !scope_current redraw() } }}
            }
            let day = "" if ledger_day_only { day = selected }
            Label{width: Fill text: scope_label() + "支出 ¥" + money(calendar_sum(day,"",scope_id())) draw_text.color: accent}
            for e in calendar_query(day,"",scope_id(),"ledger") {
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 46 text: e.date + "  " + projection_label(e) on_click: || view_open(e.source_record_id)}
            }
        }}
        graph_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            let graph = flow_query(active_flow)
            Label{width: Fill text: graph.name draw_text.color: ink draw_text.text_style.font_size: 22}
            Label{width: Fill text: "已发生 ¥" + money(graph.amount_minor) + " · " + graph.plans + " 项计划" draw_text.color: accent}
            if graph.nodes.len() > 0 { Label{width: Fill text: graph.nodes[0].date + " — " + graph.nodes[graph.nodes.len()-1].date draw_text.color: muted draw_text.text_style.font_size: 10} }
            for e in graph.nodes { if e.source_module == "calendar" {
                for edge in graph.relations { if edge.type == "follow_up" && edge.to_node == e.source_record_id {
                    let parent = source_get(edge.from_node)
                    if parent != nil { Label{width: Fill text: "┊ " + graph_node_label(graph,parent.id) + " → 明确后续安排 ↓" draw_text.color: muted draw_text.text_style.font_size: 11} }
                } if edge.type == "fulfills" && edge.from_node == e.source_record_id { Label{width: Fill text: "━━ 完成计划 → " + source_get(edge.to_node).title draw_text.color: accent} } }
                let border = "━━ 已发生" if e.status == "planned" { border = "┄ ┄ 计划 ┄ ┄" } if e.status == "cancelled" { border = "已撤回" } if flow_plan_fulfilled(e.source_record_id) { border = "━━ 计划已实现" }
                SolidView{width: Fill height: Fit flow: Down padding: 10 spacing: 5 draw_bg.color: #xffffff
                    Label{width: Fill text: border + " · " + e.date + " " + e.time draw_text.color: accent draw_text.text_style.font_size: 11}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: graph_node_label(graph,e.source_record_id) on_click: || view_open(e.source_record_id)}
                    for edge in graph.relations { if edge.type == "expense_for" && edge.from_node == e.source_record_id {
                        let expense = expense_get(edge.to_node)
                        if expense != nil { View{width: Fill height: 44 flow: Right spacing: 4
                            Label{width: 96 text: "费用归属 →" draw_text.color: muted draw_text.text_style.font_size: 11 draw_text.max_lines: 1}
                            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: "记账 · " + expense.title + " ¥" + money(expense.cents) on_click: || view_open(expense.id)}
                        } }
                    } }
                }
            } }
            for e in graph.nodes { if e.source_module == "expense" && !flow_expense_attached(e.source_record_id,active_flow) { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: "独立费用 · " + projection_label(e) on_click: || view_open(e.source_record_id)} } }
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "删除事件关系（保留源记录）" on_click: || delete_flow()}
        }}
        detail_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            let r = source_get(detail_id)
            if r != nil {
                Label{width: Fill text: r.title draw_text.color: ink draw_text.text_style.font_size: 23}
                Label{width: Fill text: r.date draw_text.color: muted}
                if r.kind == "expense" { Label{text: "¥" + money(r.cents) draw_text.color: accent draw_text.text_style.font_size: 26}
                    Label{width: Fill text: business_optional(r,"category","") draw_text.color: muted}
                    Label{width: Fill text: record_tags_text(r) draw_text.color: accent}
                }
                else { if r.kind == "period_entry" { let end = r.end_date if end == "" { end = "还未记结束日期" } Label{width: Fill text: "结束：" + end draw_text.color: muted} } else { Label{text: state_label(r.status) + " · " + r.time draw_text.color: accent} } }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: "修改" on_click: || view_edit()}
                if r.kind == "event" { for cost in event_expenses(r.id,"","") { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: "费用 · " + cost.summary + " ¥" + money(cost.amount_minor) on_click: || view_open(cost.source_record_id)} } }
                if r.kind == "expense" { for rel in flow_relations(db) { if rel.type == "expense_for" && rel.to_node == r.id { let fact = source_get(rel.from_node) if fact != nil { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 40 text: "相关事项 · " + fact.title on_click: || view_open(fact.id)} } } } }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "定位到日历" on_click: || { jump_date = r.date jump() go("calendar") }}
                for f in flow_catalog(db) { if member(r,f.id) { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "回看「" + f.name + "」" on_click: || recall_open_flow(f.id)} } }
                if r.kind != "period_entry" {
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "调整关联 ▾" on_click: || { membership_open = !membership_open ui.detail_page.render() }}
                    if membership_open {
                    for f in flow_catalog(db) { let action = "加入 " if member(r,f.id) { action = "移出 " } ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: action + f.name on_click: || toggle_member(f.id)} }
                    for f in flow_catalog(db) { if member(r,f.id) { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "管理关联 · " + f.name on_click: || graph_open(f.id)} } }
                    }
                }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "删除源记录" on_click: || delete_record()}
            } else { Label{text: "记录已删除" draw_text.color: muted} }
        }}
        edit_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            Label{text: "修改 / 记录" draw_text.color: ink draw_text.text_style.font_size: 20}
            if draft_kind == "period_entry" { Label{width: Fill text: "开始日期" draw_text.color: ink} }
            else { record_title := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_title empty_text: "事项" on_change: |v| { draft_title = v }} }
            record_date := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_date empty_text: "YYYY-MM-DD" on_change: |v| { draft_date = v }}
            if draft_kind == "expense" { record_amount := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_value empty_text: "金额（元）" on_change: |v| { draft_value = v }}
                record_category := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_category empty_text: "分类（可选）" on_change: |v| { draft_category = v }}
            }
            if draft_kind == "period_entry" {
                Label{width: Fill text: "上方为开始日期；尚未结束可留空下方。" draw_text.color: muted}
                record_end := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_end empty_text: "结束日期 YYYY-MM-DD，可空" on_change: |v| { draft_end = v }}
            }
            if draft_kind == "event" {
                record_time := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 42 text: draft_time empty_text: "时间 HH:MM，可空" on_change: |v| { draft_time = v }}
                Label{text: state_label(draft_status) draw_text.color: accent}
                View{width: Fill height: 40 flow: Right
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "计划" on_click: || { draft_status = "planned" redraw() }}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "确认已发生" on_click: || { draft_status = "occurred" redraw() }}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "撤回" on_click: || { draft_status = "cancelled" redraw() }}
                }
            }
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 44 text: "保存记录" on_click: || save_record()}
        }}
        settings_page := ScrollYView{width: Fill height: Fill flow: Down spacing: 7 visible: true on_render: || {
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 text: "‹ 返回" on_click: || view_back()}
            Label{text: "本地数据" draw_text.color: ink draw_text.text_style.font_size: 22}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "导出备份" on_click: || export_backup()}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "恢复 backup.json" on_click: || restore_backup()}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill text: "导入旧账本" on_click: || expense_import()}
            Label{width: Fill text: "备份保留全部历史个人数据。恢复前会另存副本。" draw_text.color: muted}
        }}
        }
        help_page := View{width: Fill height: Fill flow: Down spacing: 10 visible: false
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 34 text: "‹ 返回刚才的页面" on_click: || help_back()}
            help_content := ScrollYView{width: Fill height: Fill flow: Down spacing: 18 on_render: || {
                if help_topic < 0 {
                    Label{width: Fill text: "慢慢来，先记一件事。" draw_text.color: ink draw_text.text_style.font_size: 20}
                    Label{width: Fill text: "用到哪里，就看哪一节。说明离线可读，例句不会自动保存。" draw_text.color: muted draw_text.text_style.font_size: 12}
                    for index in help_sections.len() { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 42 text: help_sections[index].title on_click: || help_select(index)} }
                } else {
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 34 text: "‹ 说明目录" on_click: || help_select(-1)}
                    let section = help_sections[help_topic]
                    Label{width: Fill text: section.title draw_text.color: ink draw_text.text_style.font_size: 20}
                    for paragraph in section.paragraphs { Label{width: Fill text: paragraph draw_text.color: ink draw_text.text_style.font_size: 12} }
                }
            }}
        }
        }
    }
    }
}

// 65_experience_ui: unified experience reading page with overlays (NF-05/06/07).
// Structure: experience_shell is a static Overlay-flow container whose children
// are permanent named layers with their own on_render closures:
//   ex_base            — rail + main + (wide) detail column
//   ex_layer_drawer    — narrow detail drawer (scrim + right panel)
//   ex_layer_space/settings/original/changes — modal overlays (scrim + panel)
// Opening/closing a layer renders only that layer and toggles visibility, so
// the base page keeps its scroll position and drafts (NF-05 return contract).
// Plain views do not capture hits: every panel carries a full-size background
// ButtonFlat so panel padding clicks never reach the scrim (NF-02 finding).
// Honesty rules: imported samples are never shown as authorized connections;
// same-day grouping never implies causality; exclusions/restores happen in
// detail or the dedicated removed view, not as full-width inline buttons.
experience_shell := SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: #xf7f6f1
    ex_base := SolidView{width: Fill height: Fill on_render: || {
    exr_reset()
    let mx = 16 let my = 40 if layout_wide { mx = 300 my = 48 }
    let rail_width = 88 if layout_wide { rail_width = 196 }
    View{width: Fill height: Fill flow: Right
        SolidView{width: rail_width height: Fill flow: Down padding: 10 spacing: 10 draw_bg.color: #xeef1e9
            let brand = "DF" if layout_wide { brand = "DailyFlow" }
            Label{width: Fill text: brand draw_text.color: ink draw_text.text_style.font_size: 18}
            Label{width: Fill text: "经历目录" draw_text.color: muted draw_text.text_style.font_size: 11}
            experience_ready := Label{width: Fill text: message draw_text.color: muted draw_text.text_style.font_size: 9}
            TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 34 text: ex_search empty_text: "搜索经历" on_change: |v| { ex_search = v ex_redraw() }}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "+ 新建经历" on_click: || ex_new()}
            ex_directory := ScrollYView{width: Fill height: Fill flow: Down spacing: 7
                if ex_store != nil && !ex_store_error {
                    for it in ex_store.items { if ex_search == "" || it.title.search(ex_search) >= 0 { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 52 text: it.title on_click: || ex_select(it)} } }
                    if ex_store.items.len() == 0 { Label{width: Fill text: "保存一段回顾，\n从这里继续。" draw_text.color: muted draw_text.text_style.font_size: 11} }
                }
            }
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "我的空间" on_click: || ex_overlay_open("space")}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "工作台" on_click: || { ex_overlay_close() ex_legacy() }}
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "设置" on_click: || ex_overlay_open("settings")}
        }
        View{width: Fill height: Fill flow: Down padding: 16 spacing: 10
            View{width: Fill height: 32 flow: Right spacing: 6
                Label{width: Fill text: ex_title draw_text.color: ink draw_text.text_style.font_size: 20 draw_text.text_overflow: Ellipsis draw_text.max_lines: 1}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 54 height: 30 text: "布局" on_click: || { layout_wide = !layout_wide ex_redraw() }}
            }
            if ex_topic == "" {
                ScrollYView{width: Fill height: Fill flow: Down spacing: 12
                    if ex_store != nil && ex_store.items.len() > 0 { Label{width: Fill text: "从左侧选择一段经历，或直接提问让助手整理。" draw_text.color: ink draw_text.text_style.font_size: 16} }
                    if ex_store == nil || ex_store.items.len() == 0 {
                        Label{width: Fill text: "想把哪段经历串起来？" draw_text.color: ink draw_text.text_style.font_size: 23}
                        Label{width: Fill text: "可以直接提问，让助手选择主题和必要来源；也可以浏览已同步账本或已导入样本。" draw_text.color: muted draw_text.text_style.font_size: 12}
                    }
                    for topic in ex_topics() { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 38 text: "浏览 · " + ex_label(topic) on_click: || ex_browse(topic)} }
                    if timeline_error != "" { Label{width: Fill text: timeline_error draw_text.color: muted draw_text.text_style.font_size: 12} }
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 34 text: "重新读取已导入数据" on_click: || ex_refresh()}
                }
            } else {
                // ---- One reading scroller: metadata, overview and timeline move together. ----
                ScrollYView{width: Fill height: Fill flow: Down spacing: 12
                Label{width: Fill text: ex_meta_line() draw_text.color: muted draw_text.text_style.font_size: 11}
                Label{width: Fill text: ex_update_line() draw_text.color: muted draw_text.text_style.font_size: 10 draw_text.text_overflow: Ellipsis draw_text.max_lines: 1}
                View{width: Fill height: 30 flow: Right spacing: 5
                    for src in ex_source_chips() { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: ex_source_label(src) on_click: || ex_overlay_open("settings")} }
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 96 height: 30 text: "查看范围 ›" on_click: || ex_overlay_open("settings")}
                }
                let overview = exr_claims()
                SolidView{width: Fill height: Fit flow: Down padding: 10 spacing: 6 draw_bg.color: #xeef2e8
                    if overview.len() == 0 { Label{width: Fill text: "还没有当前有效的概括。请让助手整理这段经历；来源更正后旧概括会隐藏。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                    for claim in overview {
                        Label{width: Fill text: "✦ " + claim.text draw_text.color: ink draw_text.text_style.font_size: 13}
                        for ref in claim.evidence { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 28 text: "查看依据 · " + ref.quote on_click: || ex_detail_open(ex_reason_ref_key(ref))} }
                    }
                    Label{width: Fill text: "概括为助手建议，可逐条核对；按日期分组，同日不表示因果。" draw_text.color: muted draw_text.text_style.font_size: 10}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    let strip = "来源状态：" + ex_source_kind_summary() + " · 保存在本机" if ex_diff != "" { strip = "本次更新：" + ex_diff }
                    Label{width: Fill text: strip draw_text.color: muted draw_text.text_style.font_size: 11 draw_text.text_overflow: Ellipsis draw_text.max_lines: 1}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 96 height: 28 text: "查看变化 ›" on_click: || ex_overlay_open("changes")}
                }
                Label{width: Fill text: exr_money_line() draw_text.color: accent draw_text.text_style.font_size: 12}
                View{width: Fill height: 34 flow: Right spacing: 6
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 32 text: "重新读取" on_click: || ex_refresh()}
                    let removed_label = "已排除" if ex_removed { removed_label = "返回时间流" }
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 32 text: removed_label on_click: || { ex_removed = !ex_removed ex_detail = "" ex_redraw() }}
                    if ex_id == "" { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 32 text: "保存为经历" on_click: || ex_save()} }
                }
                    if !ex_removed {
                        if ex_invalid_edge_count() > 0 { Label{width: Fill text: "有 " + ex_invalid_edge_count() + " 条关联的依据已变化，需要重新整理。" draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                    }
                    for date in exr_dates() {
                        Label{width: Fill text: date draw_text.color: accent draw_text.text_style.font_size: 14}
                        for r in exr_for_date(date) {
                            SolidView{width: Fill height: Fit flow: Down padding: 12 spacing: 7 draw_bg.color: #xffffff
                                Label{width: Fill text: r.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{width: Fill text: timeline_kind_label(r.kind) + " · " + ex_source_label(r.source_app) draw_text.color: muted draw_text.text_style.font_size: 11}
                                if r.suspicious || r.future { Label{width: Fill text: timeline_flags(r) draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                                if r.kind == "expense" {
                                    let amount_label = "金额待补充"
                                    if r.amount_minor >= 0 { amount_label = business_optional(r,"currency","") + " " + money(r.amount_minor) }
                                    Label{width: Fill text: amount_label draw_text.color: accent draw_text.text_style.font_size: 14}
                                }
                                if ex_removed {
                                    if timeline_record_excluded(r) { Label{width: Fill text: "来源或旧时间流已排除；请在原入口核对。" draw_text.color: muted draw_text.text_style.font_size: 11} }
                                    else { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "恢复到这段经历" on_click: || ex_decide(r,"membership","clear")} }
                                } else {
                                    View{width: Fill height: 30 flow: Right spacing: 6
                                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 96 height: 30 text: "查看记录" on_click: || ex_detail_open(ex_key(r))}
                                        if r.kind == "expense" && !r.future {
                                            let fee_label = "确认计入这段经历" if ex_confirmed(r) { fee_label = "撤销费用确认" }
                                            let fee_action = "confirm" if ex_confirmed(r) { fee_action = "clear" }
                                            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: fee_label on_click: || ex_decide(r,"expense",fee_action)}
                                        }
                                    }
                                    if r.kind == "expense" && !r.future {
                                        let decision = ex_decision(r,"expense")
                                        if decision != nil && decision.revision != r.revision { Label{width: Fill text: "来源已更正，请重新核对费用。" draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                                    }
                                }
                            }
                        }
                        // candidate relations confirmed in place, anchored at their date
                        if !ex_removed {
                            for item in ex_edges_for_date(date) {
                                SolidView{width: Fill height: Fit flow: Down padding: 10 spacing: 6 draw_bg.color: #xf4f7f2
                                    let e = item.edge let state = item.status
                                    Label{width: Fill text: ex_reason_label(state) + " · " + ex_edge_kind_label(e.kind) draw_text.color: accent draw_text.text_style.font_size: 11}
                                    Label{width: Fill text: e.title draw_text.color: ink draw_text.text_style.font_size: 14}
                                    Label{width: Fill text: e.reason draw_text.color: muted draw_text.text_style.font_size: 12}
                                    View{width: Fill height: 30 flow: Right spacing: 6
                                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "起点 · " + e.from.quote on_click: || ex_detail_open(ex_reason_ref_key(e.from))}
                                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "另一端 · " + e.to.quote on_click: || ex_detail_open(ex_reason_ref_key(e.to))}
                                    }
                                    View{width: Fill height: 30 flow: Right spacing: 6
                                        if state != "confirmed" { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "确认相关" on_click: || ex_reason_decide(e,"confirmed")} }
                                        if state != "rejected" { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "不相关" on_click: || ex_reason_decide(e,"rejected")} }
                                        if state != "pending" { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "重新核对" on_click: || ex_reason_decide(e,"clear")} }
                                    }
                                }
                            }
                        }
                    }
                    if exr_dates().len() == 0 { Label{width: Fill text: "当前范围内没有可展示的记录。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                }
            }
            Label{width: Fill text: ex_status draw_text.color: muted draw_text.text_style.font_size: 11}
            View{width: Fill height: 28 flow: Right spacing: 6
                if ex_last_undo != nil { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 28 text: "撤销上次决定" on_click: || ex_undo()} }
                if ex_reason_undo_last != nil { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 28 text: "撤销上次关联决定" on_click: || ex_reason_undo()} }
            }
            if ex_show_process { ScrollYView{width: Fill height: 88 flow: Down spacing: 4 for event in ex_events { Label{width: Fill text: event.sequence + ". " + event.text draw_text.color: muted draw_text.text_style.font_size: 10} }} }
            experience_input := TextInput{draw_bg +: {color: #xf4f5f1 color_hover: #xf4f5f1 color_focus: #xffffff color_empty: #xf4f5f1} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted} width: Fill height: 44 text: ex_question empty_text: "问问这段经历，比如：我是怎么开始攀岩的？" on_change: |v| { ex_question = v } on_return: |v| ex_send()}
            View{width: Fill height: 34 flow: Right spacing: 6
                let send_label = "请助手整理" if ex_busy { send_label = "正在整理…" }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 34 text: send_label on_click: || ex_send()}
                if ex_busy { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 58 height: 34 text: "停止" on_click: || { ex_cancel() ex_redraw() }} }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: 72 height: 34 text: "整理过程" on_click: || { ex_show_process = !ex_show_process ex_redraw() }}
            }
        }
        // ---- wide: fixed-width detail column (NF-07) ----
        if ex_detail != "" && layout_wide {
            SolidView{width: 340 height: Fill flow: Down padding: 12 spacing: 10 draw_bg.color: #xffffff
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 32 text: "‹ 返回时间流" on_click: || ex_detail_close()}
                Label{width: Fill text: "记录详情" draw_text.color: ink draw_text.text_style.font_size: 18}
                ScrollYView{width: Fill height: Fill flow: Down spacing: 10
                    let d = exr_detail_record()
                    if d == nil { Label{width: Fill text: "这条记录已不在可访问的当前范围中，旧内容已隐藏。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                    else {
                        Label{width: Fill text: "来自 " + ex_source_label(d.source_app) + " · " + d.date draw_text.color: muted draw_text.text_style.font_size: 11}
                        Label{width: Fill text: d.title draw_text.color: ink draw_text.text_style.font_size: 17}
                        if d.kind == "expense" {
                            let damount = "金额待补充" if d.amount_minor >= 0 { damount = business_optional(d,"currency","") + " " + money(d.amount_minor) }
                            Label{width: Fill text: damount draw_text.color: accent draw_text.text_style.font_size: 16}
                        }
                        if d.body != "" { Label{width: Fill text: d.body draw_text.color: ink draw_text.text_style.font_size: 13} }
                        if d.suspicious || d.future { Label{width: Fill text: timeline_flags(d) draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                        Label{width: Fill text: "为什么出现在这里" draw_text.color: accent draw_text.text_style.font_size: 13}
                        let rels = ex_edges_about(d)
                        if rels.len() == 0 { Label{width: Fill text: "来源记录属于所选主题与日期范围；同日展示不表示已经确认关联。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                        for item in rels {
                            SolidView{width: Fill height: Fit flow: Down padding: 8 spacing: 4 draw_bg.color: #xf4f7f2
                                Label{width: Fill text: ex_edge_kind_label(item.edge.kind) + " · " + ex_reason_label(item.status) draw_text.color: accent draw_text.text_style.font_size: 11}
                                Label{width: Fill text: item.edge.reason draw_text.color: muted draw_text.text_style.font_size: 12}
                                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 28 text: "查看另一端 · " + ex_edge_other(item.edge,ex_key(d)).quote on_click: || ex_detail_open(ex_reason_ref_key(ex_edge_other(item.edge,ex_key(d))))}
                            }
                        }
                        Label{width: Fill text: "来源信息 · " + ex_key(d) + " · rev " + d.revision draw_text.color: muted draw_text.text_style.font_size: 10}
                        if d.citation != "" { Label{width: Fill text: d.citation draw_text.color: muted draw_text.text_style.font_size: 10} }
                        if d.kind == "expense" && !d.future {
                            let dfee = "确认计入这段经历" if ex_confirmed(d) { dfee = "撤销费用确认" }
                            let dfee_action = "confirm" if ex_confirmed(d) { dfee_action = "clear" }
                            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: dfee on_click: || ex_decide(d,"expense",dfee_action)}
                            let ddecision = ex_decision(d,"expense")
                            if ddecision != nil && ddecision.revision != d.revision { Label{width: Fill text: "来源已更正，请重新核对费用。" draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                        }
                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "查看原始记录" on_click: || ex_overlay_open("original")}
                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "从这段经历移除" on_click: || { ex_decide(d,"membership","exclude") ex_detail_close() }}
                        Label{width: Fill text: "仅移除关联，来源中的原记录保留。" draw_text.color: muted draw_text.text_style.font_size: 10}
                    }
                }
            }
        }
    }
    nf_external_rendered(ex_id)
    }}
    // ================= narrow: detail drawer layer (NF-07) =================
    ex_layer_drawer := View{width: Fill height: Fill flow: Right on_render: || {
        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #x1a1a1a55 color_hover: #x1a1a1a55 color_down: #x1a1a1a55} label_walk: Walk{width: Fit height: Fit} on_click: || ex_detail_close()}
        View{width: 340 height: Fill flow: Overlay
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #xffffff color_hover: #xffffff color_down: #ffffff} label_walk: Walk{width: Fit height: Fit} on_click: || { }}
            SolidView{width: Fill height: Fill flow: Down padding: 12 spacing: 10 draw_bg.color: #xffffff
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 32 text: "‹ 返回时间流" on_click: || ex_detail_close()}
                Label{width: Fill text: "记录详情" draw_text.color: ink draw_text.text_style.font_size: 18}
                ScrollYView{width: Fill height: Fill flow: Down spacing: 10
                    let d = exr_detail_record()
                    if d == nil { Label{width: Fill text: "这条记录已不在可访问的当前范围中，旧内容已隐藏。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                    else {
                        Label{width: Fill text: "来自 " + ex_source_label(d.source_app) + " · " + d.date draw_text.color: muted draw_text.text_style.font_size: 11}
                        Label{width: Fill text: d.title draw_text.color: ink draw_text.text_style.font_size: 17}
                        if d.kind == "expense" {
                            let damount = "金额待补充" if d.amount_minor >= 0 { damount = business_optional(d,"currency","") + " " + money(d.amount_minor) }
                            Label{width: Fill text: damount draw_text.color: accent draw_text.text_style.font_size: 16}
                        }
                        if d.body != "" { Label{width: Fill text: d.body draw_text.color: ink draw_text.text_style.font_size: 13} }
                        if d.suspicious || d.future { Label{width: Fill text: timeline_flags(d) draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                        Label{width: Fill text: "为什么出现在这里" draw_text.color: accent draw_text.text_style.font_size: 13}
                        let rels = ex_edges_about(d)
                        if rels.len() == 0 { Label{width: Fill text: "来源记录属于所选主题与日期范围；同日展示不表示已经确认关联。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                        for item in rels {
                            SolidView{width: Fill height: Fit flow: Down padding: 8 spacing: 4 draw_bg.color: #xf4f7f2
                                Label{width: Fill text: ex_edge_kind_label(item.edge.kind) + " · " + ex_reason_label(item.status) draw_text.color: accent draw_text.text_style.font_size: 11}
                                Label{width: Fill text: item.edge.reason draw_text.color: muted draw_text.text_style.font_size: 12}
                                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 28 text: "查看另一端 · " + ex_edge_other(item.edge,ex_key(d)).quote on_click: || ex_detail_open(ex_reason_ref_key(ex_edge_other(item.edge,ex_key(d))))}
                            }
                        }
                        Label{width: Fill text: "来源信息 · " + ex_key(d) + " · rev " + d.revision draw_text.color: muted draw_text.text_style.font_size: 10}
                        if d.citation != "" { Label{width: Fill text: d.citation draw_text.color: muted draw_text.text_style.font_size: 10} }
                        if d.kind == "expense" && !d.future {
                            let dfee = "确认计入这段经历" if ex_confirmed(d) { dfee = "撤销费用确认" }
                            let dfee_action = "confirm" if ex_confirmed(d) { dfee_action = "clear" }
                            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: dfee on_click: || ex_decide(d,"expense",dfee_action)}
                            let ddecision = ex_decision(d,"expense")
                            if ddecision != nil && ddecision.revision != d.revision { Label{width: Fill text: "来源已更正，请重新核对费用。" draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                        }
                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "查看原始记录" on_click: || ex_overlay_open("original")}
                        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "从这段经历移除" on_click: || { ex_decide(d,"membership","exclude") ex_detail_close() }}
                        Label{width: Fill text: "仅移除关联，来源中的原记录保留。" draw_text.color: muted draw_text.text_style.font_size: 10}
                    }
                }
            }
        }
    }}
    // ================= modal overlay layers (NF-05) =================
    ex_layer_space := View{width: Fill height: Fill flow: Overlay on_render: || {
        let mx = 16 let my = 40 if layout_wide { mx = 300 my = 48 }
        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #x1a1a1a55 color_hover: #x1a1a1a55 color_down: #x1a1a1a55} label_walk: Walk{width: Fit height: Fit} on_click: || ex_overlay_close()}
        View{width: Fill height: Fill margin: Inset{left: mx right: mx top: my bottom: my} flow: Overlay
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #ffffff color_hover: #xffffff color_down: #ffffff} label_walk: Walk{width: Fit height: Fit} on_click: || { }}
            SolidView{width: Fill height: Fill flow: Down padding: 18 spacing: 10 draw_bg.color: #xffffff
                Label{width: Fill text: "我的空间" draw_text.color: ink draw_text.text_style.font_size: 22}
                Label{width: Fill text: "经历、核验决定与已导入样本都保存在这台设备的本机数据目录；无需账号。" draw_text.color: ink draw_text.text_style.font_size: 12}
                SolidView{width: Fill height: Fit flow: Down padding: 10 spacing: 6 draw_bg.color: #xf4f7f2
                    Label{width: Fill text: "保存方式：本机数据目录" draw_text.color: ink draw_text.text_style.font_size: 12}
                    Label{width: Fill text: "空间存储：仅本机；整理时所选内容可能发送至宿主配置的模型服务" draw_text.color: ink draw_text.text_style.font_size: 12}
                    Label{width: Fill text: "云端备份：尚未开放" draw_text.color: ink draw_text.text_style.font_size: 12}
                }
                Label{width: Fill text: "「本机保存」不等于备份；导出与恢复备份在原有工作台 → 数据。" draw_text.color: muted draw_text.text_style.font_size: 11}
                View{width: Fill height: Fill}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 38 text: "打开原有工作台（对话 / 日历 / 账本）" on_click: || { ex_overlay_close() ex_legacy() }}
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "关闭" on_click: || ex_overlay_close()}
            }
        }
    }}
    ex_layer_settings := View{width: Fill height: Fill flow: Overlay on_render: || {
        let mx = 16 let my = 40 if layout_wide { mx = 300 my = 48 }
        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #x1a1a1a55 color_hover: #x1a1a1a55 color_down: #x1a1a1a55} label_walk: Walk{width: Fit height: Fit} on_click: || ex_overlay_close()}
        View{width: Fill height: Fill margin: Inset{left: mx right: mx top: my bottom: my} flow: Overlay
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #ffffff color_hover: #xffffff color_down: #ffffff} label_walk: Walk{width: Fit height: Fit} on_click: || { }}
            SolidView{width: Fill height: Fill flow: Down padding: 18 spacing: 10 draw_bg.color: #ffffff
                Label{width: Fill text: "设置" draw_text.color: ink draw_text.text_style.font_size: 22}
                ScrollYView{width: Fill height: Fill flow: Down spacing: 12
                    Label{width: Fill text: "连接与授权" draw_text.color: accent draw_text.text_style.font_size: 15}
                    Label{width: Fill text: "每个来源的连接状态、宿主授权与本应用读取范围分别显示。下面的开关只控制本应用的展示与整理范围，不改变宿主授权。" draw_text.color: muted draw_text.text_style.font_size: 12}
                    let conns = ex_conn_states()
                    if conns.len() == 0 { Label{width: Fill text: "尚未导入或连接任何来源。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                    let has_indep = false
                    for s in conns {
                        if s.kind == "independent_app" { has_indep = true }
                        SolidView{width: Fill height: Fit flow: Down padding: 10 spacing: 5 draw_bg.color: #xf4f7f2
                            Label{width: Fill text: ex_conn_label(s) + " · " + ex_conn_kind_label(s.kind) draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "连接：" + ex_conn_state_label(s.connection) + " ｜ 授权：" + ex_conn_auth_label(s.authorization) draw_text.color: muted draw_text.text_style.font_size: 11}
                            if s.connection == "imported" { Label{width: Fill text: "读取范围：本来源导入快照；主题和日期按当前经历筛选" draw_text.color: muted draw_text.text_style.font_size: 10} }
                            else { Label{width: Fill text: "读取范围：独立账本支出；同步需要当前宿主授权" draw_text.color: muted draw_text.text_style.font_size: 10} }
                            let syncline = ex_conn_sync_label(s) if syncline != "" { Label{width: Fill text: syncline draw_text.color: muted draw_text.text_style.font_size: 11} }
                            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: ex_conn_scope_label(s) on_click: || ex_conn_toggle(s)}
                            if s.kind == "independent_app" {
                                if s.sync_state == "reading" || s.sync_state == "validating" { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "取消同步" on_click: || ex_conn_cancel(s)} }
                                else { if s.scope_enabled { ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 30 text: "同步独立账本" on_click: || ex_conn_sync(s)} } }
                            }
                            if s.connection == "unavailable" || s.connection == "unknown" { Label{width: Fill text: "当前连接尚未验证；同步时由宿主核验授权，拒绝或撤权会停止读取。" draw_text.color: muted draw_text.text_style.font_size: 11} }
                        }
                    }
                    if !has_indep { Label{width: Fill text: "独立账本 App（dailyflow-ledger）：来源状态不可用；未读取。" draw_text.color: muted draw_text.text_style.font_size: 11} }
                    Label{width: Fill text: "导入样本与文件导入不涉及账号授权，不显示为已授权连接。" draw_text.color: muted draw_text.text_style.font_size: 11}
                    Label{width: Fill text: "文件导入" draw_text.color: accent draw_text.text_style.font_size: 15}
                    Label{width: Fill text: "社媒与日历样本使用文件导入。先按仓库导入说明运行 tools/sync_timeline_import.py，将 timeline-imported.json 放入应用数据目录，再点击下方重新读取。这里不会启动外部脚本或连接社媒。" draw_text.color: muted draw_text.text_style.font_size: 12}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "重新读取已导入数据" on_click: || ex_refresh()}
                    Label{width: Fill text: ex_status draw_text.color: muted draw_text.text_style.font_size: 10}
                    Label{width: Fill text: "备份与同步" draw_text.color: accent draw_text.text_style.font_size: 15}
                    Label{width: Fill text: "当前保存在本机，无需登录；云端同步尚未开放。助手整理可能将所选内容发送给模型服务。原有本地备份在工作台 → 数据。" draw_text.color: muted draw_text.text_style.font_size: 12}
                    Label{width: Fill text: "助手入口" draw_text.color: accent draw_text.text_style.font_size: 15}
                    ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 34 text: "助手入口 · " + ex_adapter on_click: || { ex_cancel() if ex_adapter == "official" { ex_adapter = "model" } else { ex_adapter = "official" } ex_layer_render("settings") }}
                    Label{width: Fill text: "官方 Agent 使用宿主的 Provider 和授权；模型直连可作为显式备用入口。两者都只读取已授权且启用的独立来源及导入样本。" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "回到经历" on_click: || ex_overlay_close()}
            }
        }
    }}
    ex_layer_original := View{width: Fill height: Fill flow: Overlay on_render: || {
        let mx = 16 let my = 40 if layout_wide { mx = 300 my = 48 }
        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #x1a1a1a55 color_hover: #x1a1a1a55 color_down: #x1a1a1a55} label_walk: Walk{width: Fit height: Fit} on_click: || ex_overlay_close()}
        View{width: Fill height: Fill margin: Inset{left: mx right: mx top: my bottom: my} flow: Overlay
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #ffffff color_hover: #ffffff color_down: #ffffff} label_walk: Walk{width: Fit height: Fit} on_click: || { }}
            SolidView{width: Fill height: Fill flow: Down padding: 18 spacing: 10 draw_bg.color: #ffffff
                Label{width: Fill text: "原始记录" draw_text.color: ink draw_text.text_style.font_size: 20}
                ScrollYView{width: Fill height: Fill flow: Down spacing: 8
                    let od = exr_detail_record()
                    if od == nil { Label{width: Fill text: "该记录已不在当前范围，原始内容已隐藏。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                    else {
                        Label{width: Fill text: "标题：" + od.title draw_text.color: ink draw_text.text_style.font_size: 13}
                        if od.body != "" { Label{width: Fill text: "正文：" + od.body draw_text.color: ink draw_text.text_style.font_size: 12} }
                        Label{width: Fill text: "类型：" + timeline_kind_label(od.kind) + "（" + od.kind + "）" draw_text.color: muted draw_text.text_style.font_size: 11}
                        Label{width: Fill text: "日期：" + od.date draw_text.color: muted draw_text.text_style.font_size: 11}
                        Label{width: Fill text: "来源身份：" + ex_key(od) draw_text.color: muted draw_text.text_style.font_size: 11}
                        Label{width: Fill text: "修订：rev " + od.revision draw_text.color: muted draw_text.text_style.font_size: 11}
                        if od.kind == "expense" && od.amount_minor >= 0 { Label{width: Fill text: "金额：" + business_optional(od,"currency","") + " " + money(od.amount_minor) + "（最小单位 " + od.amount_minor + "）" draw_text.color: muted draw_text.text_style.font_size: 11} }
                        if od.citation != "" { Label{width: Fill text: "引用来源查询：" + od.citation draw_text.color: muted draw_text.text_style.font_size: 11} }
                        if od.suspicious || od.future { Label{width: Fill text: timeline_flags(od) draw_text.color: #x8a6d00 draw_text.text_style.font_size: 11} }
                        Label{width: Fill text: "该记录来自文件导入样本；未连接实时来源。" draw_text.color: muted draw_text.text_style.font_size: 11}
                    }
                }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "关闭" on_click: || ex_overlay_close()}
            }
        }
    }}
    ex_layer_changes := View{width: Fill height: Fill flow: Overlay on_render: || {
        let mx = 16 let my = 40 if layout_wide { mx = 300 my = 48 }
        ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #x1a1a1a55 color_hover: #x1a1a1a55 color_down: #x1a1a1a55} label_walk: Walk{width: Fit height: Fit} on_click: || ex_overlay_close()}
        View{width: Fill height: Fill margin: Inset{left: mx right: mx top: my bottom: my} flow: Overlay
            ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: Fill text: "" draw_bg +: {color: #xffffff color_hover: #xffffff color_down: #ffffff} label_walk: Walk{width: Fit height: Fit} on_click: || { }}
            SolidView{width: Fill height: Fill flow: Down padding: 18 spacing: 10 draw_bg.color: #ffffff
                Label{width: Fill text: "这段经历的变化" draw_text.color: ink draw_text.text_style.font_size: 20}
                ScrollYView{width: Fill height: Fill flow: Down spacing: 8
                    if ex_diff != "" { Label{width: Fill text: "本次重新读取：" + ex_diff draw_text.color: ink draw_text.text_style.font_size: 12} }
                    else { Label{width: Fill text: "本次打开后尚未重新读取来源。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                    Label{width: Fill text: "来源状态：文件导入样本 · 未连接实时来源" draw_text.color: muted draw_text.text_style.font_size: 11}
                    if ex_events.len() == 0 { Label{width: Fill text: "暂无整理或读取动作记录。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                    for event in ex_events { Label{width: Fill text: event.sequence + ". " + event.text draw_text.color: muted draw_text.text_style.font_size: 11} }
                }
                ButtonFlat{draw_bg +: {color: #xf0f3ed color_hover: #xe3eadd color_down: #xd7e3d4 border_size: 0.0 border_radius: 6.0} draw_text +: {color: ink color_hover: ink color_down: ink} label_walk: Walk{width: Fill height: Fit} draw_text.text_overflow: Ellipsis draw_text.max_lines: 1 width: Fill height: 36 text: "关闭" on_click: || ex_overlay_close()}
            }
        }
    }}
}

}
