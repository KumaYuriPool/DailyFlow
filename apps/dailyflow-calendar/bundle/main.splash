                        align: Align{x: 0.5, y: 0.5}}}}
        }

        View{width: Fill height: 48 flow: Right spacing: 4
            c22 := SolidView{width: Fill height: Fill draw_bg.color: card border_radius: 8.0
                GestureView{width: Fill height: Fill on_tap: |x, y| select_day(22)
                    Label{width: Fill height: Fill text: "22" draw_text.color: ink draw_text.text_style.font_size: 18
